{
  "name": "@routeledger/ui",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -C ../.. exec tsc -p packages/ui/tsconfig.json --pretty false && pnpm exec vite build",
    "launch": "pnpm exec tsx src/server/cli.ts",
    "open": "pnpm exec tsx src/server/cli.ts open",
    "add": "pnpm exec tsx src/server/cli.ts add",
    "status": "pnpm exec tsx src/server/cli.ts status",
    "stop": "pnpm exec tsx src/server/cli.ts stop",
    "test": "pnpm -C ../.. exec vitest run --config packages/ui/vitest.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@routeledger/core": "workspace:*",
    "@routeledger/json": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
